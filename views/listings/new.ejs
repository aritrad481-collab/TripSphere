<% layout("layouts/boilerplate") %>

<div class="listing-container">

    <h3 class="page-title">
        <i class="fa-solid fa-house form-icon"></i>
        Create a New Listing
    </h3>

    <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">

        <!-- Title -->
        <div class="mb-4">
            <label for="title" class="form-label">
                Listing Title <span class="required">*</span>
            </label>

            <input
                id="title"
                name="listing[title]"
                placeholder="Enter your listing title"
                type="text"
                class="form-control"
                required
            >
            <div class="valid-feedback">Title Looks good!</div>
        </div>


        <!-- Description -->
        <div class="mb-4">
            <label for="description" class="form-label">
                Description <span class="required">*</span>
            </label>

            <textarea
                id="description"
                name="listing[description]"
                placeholder="Describe your property..."
                class="form-control"
                required
            ></textarea>
            <div class="invalid-feedback">Please enter a short description...</div>
        </div>



        <!-- UPLOAD Image -->
        <div class="mb-4">
            <label for="image" class="form-label">
                Upload Image
            </label>

            <input
                id="image"
                name="image"
                type="file"
                class="form-control"
                required
            >
        </div>


        <!-- Price + Country -->
        <div class="row">

            <!-- Price -->
            <div class="mb-4 col-md-6">
                <label for="price" class="form-label">
                    Price per night <span class="required">*</span>
                </label>

                <div class="input-group">
                    <span class="input-group-text">₹</span>

                    <input
                        id="price"
                        name="listing[price]"
                        placeholder="Enter price"
                       
                        class="form-control"
                        required
                    />
                    <div class="invalid-feedback">Please enter valid price</div>

                </div>
            </div>


            <!-- Country -->
            <div class="mb-4 col-md-6">
                <label for="country" class="form-label">
                    Country <span class="required">*</span>
                </label>

                <input
                    id="country"
                    name="listing[country]"
                    placeholder="Enter country"
                    type="text"
                    class="form-control"
                    required
                >
                <div class="invalid-feedback">Country name should be valid</div>
            </div>

        </div>


        <!-- Location -->
        <div class="mb-4">
            <label for="location" class="form-label">
                Location <span class="required">*</span>
            </label>

            <input
                id="location"
                name="listing[location]"
                placeholder="Enter city/location"
                type="text"
                class="form-control"
                required
            >
            <div class="invalid-feedback">Location should be valid</div>
        </div>


        <!-- Add Button -->
        <div class="mt-4">
            <button type="submit" class="add-btn">
                <i class="fa-solid fa-plus"></i>
                Add
            </button>
        </div>

    </form>

</div>